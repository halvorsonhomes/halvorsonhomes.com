<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body{% if heroLayout %} class="has-hero"{% endif %}>
  <header class="site-header{% if heroLayout %} site-header--transparent{% endif %}">
    <nav class="nav">
      <a href="/" class="nav-logo">{{ site.title }}</a>
      <ul class="nav-links">
        {% for item in nav %}
          <li>
            <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>
              {{ item.label }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </header>

  <main class="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>&copy; {{ site.year }} {{ site.title }} &nbsp;&middot;&nbsp; CBC1259553</p>
  </footer>
</body>
</html>
